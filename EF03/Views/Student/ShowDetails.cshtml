@model Student

<h2>تفاصيل الطالب</h2>
<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text"><strong>رقم الطالب:</strong> @Model.Id</p>
        <p class="card-text"><strong>العمر:</strong> @Model.Age</p>
        <p class="card-text"><strong>القسم:</strong> @Model.Department?.Name</p>
    </div>
</div>
<a href="/Student/ShowAll" class="btn btn-secondary">العودة للقائمة</a>